# Telegram BotFather token. Do not commit your real token.
BOT_TOKEN=123456789:replace_with_your_token

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone who knows the bot.
ALLOWED_USER_IDS=

# Optional paths.
TEMPLATE_DIR=.
GENERATED_DIR=generated

# Required for free-form messages where the bot automatically understands what to replace.
# Do not commit your real OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Default output is PDF. Use docx to skip LibreOffice conversion.
OUTPUT_FORMAT=pdf

# Optional: chat ID that receives a greeting when the bot process starts.
STARTUP_CHAT_ID=
